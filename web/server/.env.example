# Copy to server/.env — NEVER commit real keys. Server-side only.
GATEWAY_PORT=8001
PACIFICA_BASE_URL=https://test-api.pacifica.fi/api/v1
# Optional: without these, social/context panels show "unavailable" (no mocks).
ELFA_API_KEY=
COINGECKO_API_KEY=
# true = https://pro-api.coingecko.com, false = https://api.coingecko.com (free, 100/min)
COINGECKO_PRO=false
# Powers the /agents intelligence chat (OpenRouter tool-loop agent, read-only).
# Without it, the chat shows "unavailable" but the daily digest still works.
OPENROUTER_API_KEY=
# Model for intelligence answers (must support function calling).
INTEL_MODEL=cohere/north-mini-code:free
