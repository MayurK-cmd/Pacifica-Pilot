# Frontend env — no secrets here, only the gateway URL (dev proxy handles /api).
# Copy to .env if you change the gateway port.
VITE_GATEWAY_URL=http://localhost:8001
# Solana RPC for read-only wallet reads (SOL balance). Defaults to mainnet-beta.
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
